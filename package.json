{
  "name": "xbox-controllerbench",
  "version": "4.0.0",
  "description": "Browser-based tester for Xbox controllers, the Xbox chatpad and keyboards. Runs locally in Chrome. Software calibration only. Nothing is written to device firmware.",
  "private": true,
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opsecfreak/Xbox_ControllerBench.git"
  },
  "keywords": [
    "xbox-controller",
    "xbox-chatpad",
    "gamepad-api",
    "gamepad-tester",
    "keyboard-tester",
    "stick-drift",
    "chrome",
    "diagnostics"
  ],
  "author": "opsecfreak",
  "license": "MIT",
  "homepage": "https://github.com/opsecfreak/Xbox_ControllerBench#readme",
  "bugs": {
    "url": "https://github.com/opsecfreak/Xbox_ControllerBench/issues"
  }
}
